{
  "arrow": "const Repair = () => {};",
  "parameters": "const Perk = ({ perkName }) => {};",
  "state-pair": "const [item, setItem] = useState('Medkit');",
  "spread": "[...inventory, 'Medkit']",
  "rest": "const pack = (...items) => items;",
  "template": "`survivor-${id}`",
  "map": "survivors.map(s => <li>{s.name}</li>)",
  "filter": "survivors.filter(s => s.isInjured)",
  "flat-map": "chests.flatMap(c => c.items)",
  "reduce": "chests.reduce((total, chest) => total + chest.items.length, 0)",
  "ternary": "isInjured ? 'Injured!' : 'Healthy'",
  "and": "isInjured && <InjuryBadge />",
  "immutable": "const heal = survivor => ({ ...survivor, health: 100 });",
  "module-import": "import { openExitGate } from './gate';",
  "await": "const escape = async () => { await openExitGate(); };",
  "module-export": "export default escape;",
  "composition": "<VideoList><Thumbnail /><LikeButton /></VideoList>",
  "key": "key={survivor.id}",
  "state-hook": "const [progress, setProgress] = useState(0);",
  "suspense": "<Suspense fallback={<BloodwebSpinner />}><MatchStats /></Suspense>",
  "client-directive": "'use client';",
  "streaming": "renderToPipeableStream(<App />)",
  "find": "survivors.find(s => s.isInjured)"
}
